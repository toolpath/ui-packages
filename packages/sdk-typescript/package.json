{
  "name": "@toolpath/api",
  "version": "0.20.0",
  "description": "TypeScript bindings and upload helper for the Toolpath Engine API",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toolpath/ui-packages.git",
    "directory": "packages/sdk-typescript"
  },
  "homepage": "https://developers.toolpath.com",
  "bugs": {
    "url": "https://github.com/toolpath/ui-packages/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run && node scripts/verify-openapi.mjs",
    "generate": "node scripts/generate.mjs",
    "openapi:adopt": "node scripts/adopt-openapi.mjs",
    "openapi:verify": "node scripts/verify-openapi.mjs",
    "pack:check": "pnpm build && node scripts/check-package.mjs",
    "lint": "eslint . --max-warnings=0",
    "test:ci": "pnpm run test"
  },
  "devDependencies": {
    "@toolpath/dev-config": "workspace:^",
    "@types/node": "24.10.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  },
  "toolpath": {
    "openApiSha256": "9d3d66d2a8f42e4d593ea82f2283b5a84a4fa13a23711891c8560eff5c720ff6",
    "openApiVersion": "1.44.0"
  }
}
