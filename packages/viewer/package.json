{
  "name": "@toolpath/viewer",
  "version": "3.0.0",
  "description": "React Three Fiber viewer for Toolpath Engine part reports",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toolpath/ui-packages.git",
    "directory": "packages/viewer"
  },
  "homepage": "https://developers.toolpath.com",
  "bugs": {
    "url": "https://github.com/toolpath/ui-packages/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/native/index.js",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/native/index.d.ts",
        "default": "./dist/native/index.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "react-native": {
        "types": "./dist/native/engine/index.d.ts",
        "default": "./dist/native/engine/index.js"
      },
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./banana": {
      "react-native": {
        "types": "./dist/native/banana.d.ts",
        "default": "./dist/native/banana.js"
      },
      "types": "./dist/banana.d.ts",
      "import": "./dist/banana.js"
    },
    "./metro": {
      "types": "./dist/metro/index.d.cts",
      "default": "./dist/metro/index.cjs"
    },
    "./toolbar.css": "./dist/toolbar.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "check-types": "tsc --noEmit && tsc -p tsconfig.native.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "expo-asset": ">=11.1",
    "expo-gl": ">=15.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": ">=0.79",
    "three": ">=0.159.0"
  },
  "peerDependenciesMeta": {
    "expo-asset": {
      "optional": true
    },
    "expo-gl": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.185.0",
    "expo-asset": "58.0.18",
    "expo-gl": "58.0.3",
    "jsdom": "^30.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.88.0",
    "three": "0.185.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "camera-controls": "3.1.0",
    "three-mesh-bvh": "^0.8.3"
  }
}
