{
  "name": "@toolpath/app-support",
  "version": "0.1.9",
  "description": "Reusable logic for a Toolpath application: preferences, contexts and route helpers",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toolpath/ui-packages.git",
    "directory": "packages/app-support"
  },
  "homepage": "https://developers.toolpath.com",
  "bugs": {
    "url": "https://github.com/toolpath/ui-packages/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown src/index.ts src/react/index.ts --format esm --dts --clean --platform neutral",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "test:ci": "pnpm run test"
  },
  "dependencies": {
    "@toolpath/tool-support": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@toolpath/dev-config": "workspace:^",
    "@types/node": "24.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "jsdom": "^31.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsdown": "0.23.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  }
}
