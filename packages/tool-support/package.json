{
  "name": "@toolpath/tool-support",
  "version": "0.6.1",
  "description": "The cutting-tool domain: what a tool, holder, collet and assembly are",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toolpath/ui-packages.git",
    "directory": "packages/tool-support"
  },
  "homepage": "https://developers.toolpath.com",
  "bugs": {
    "url": "https://github.com/toolpath/ui-packages/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "import": "./dist/export/index.js",
      "default": "./dist/export/index.js"
    },
    "./export/fusion": {
      "types": "./dist/export/fusion/index.d.ts",
      "import": "./dist/export/fusion/index.js",
      "default": "./dist/export/fusion/index.js"
    },
    "./export/mastercam": {
      "types": "./dist/export/mastercam/index.d.ts",
      "import": "./dist/export/mastercam/index.js",
      "default": "./dist/export/mastercam/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run && node scripts/verify-fusion-schema.mjs && node scripts/verify-mastercam-schema.mjs",
    "schema:fusion:adopt": "node scripts/adopt-fusion-schema.mjs",
    "schema:fusion:check-upstream": "node scripts/check-fusion-schema-upstream.mjs",
    "schema:mastercam:adopt": "node scripts/adopt-mastercam-schema.mjs",
    "lint": "eslint . --max-warnings=0",
    "test:ci": "pnpm run test"
  },
  "devDependencies": {
    "@toolpath/dev-config": "workspace:^",
    "@types/node": "24.10.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
