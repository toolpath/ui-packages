{
  "name": "@toolpath/tool-drawing",
  "version": "1.0.4",
  "description": "2D elevation drawing of a cutting tool and its holder",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toolpath/ui-packages.git",
    "directory": "packages/tool-drawing"
  },
  "homepage": "https://developers.toolpath.com",
  "bugs": {
    "url": "https://github.com/toolpath/ui-packages/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "import": "./dist/geometry/index.js"
    },
    "./clearance": {
      "types": "./dist/clearance/index.d.ts",
      "import": "./dist/clearance/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "REACT_COMPILER_TESTS=1 vitest run",
    "test:source": "vitest run",
    "lint": "oxlint",
    "test:ci": "pnpm run test"
  },
  "dependencies": {
    "@toolpath/tool-support": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@rolldown/plugin-babel": "0.3.0",
    "@testing-library/react": "^16.3.2",
    "@toolpath/dev-config": "workspace:^",
    "@types/node": "24.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^31.0.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsdown": "0.23.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  }
}
