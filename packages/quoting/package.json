{
  "name": "@toolpath/quoting",
  "version": "0.4.2",
  "description": "The quote flow: where a part, a quote, a revision and a payment stand, what moving a part means, a part's stock and tool crib, and how units show. Logic only; views belong in @toolpath/ui",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toolpath/ui-packages.git",
    "directory": "packages/quoting"
  },
  "homepage": "https://developers.toolpath.com",
  "bugs": {
    "url": "https://github.com/toolpath/ui-packages/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./inputs": {
      "types": "./dist/inputs/index.d.ts",
      "import": "./dist/inputs/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "import": "./dist/model/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "import": "./dist/pipeline/index.js"
    },
    "./units": {
      "types": "./dist/units/index.d.ts",
      "import": "./dist/units/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown src/index.ts src/inputs/index.ts src/model/index.ts src/pipeline/index.ts src/units/index.ts --format esm --dts --clean --platform neutral",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "test:ci": "pnpm run test"
  },
  "dependencies": {
    "@toolpath/plan": "workspace:^",
    "@toolpath/tool-support": "workspace:^"
  },
  "devDependencies": {
    "@toolpath/dev-config": "workspace:^",
    "@types/node": "24.10.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "tsdown": "0.23.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  }
}
