{
  "name": "@toolpath/quoting",
  "version": "0.0.0",
  "description": "The quote flow: where a part, a quote, a revision and a payment stand, and what moving a part means. Logic only; views belong in @toolpath/ui",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toolpath/ui-packages.git",
    "directory": "packages/quoting"
  },
  "homepage": "https://developers.toolpath.com",
  "bugs": {
    "url": "https://github.com/toolpath/ui-packages/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "import": "./dist/model/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/model/index.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
