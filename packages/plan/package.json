{
  "name": "@toolpath/plan",
  "version": "1.1.0",
  "description": "Plan mode for Toolpath: the plan a person states (setups, groups, assigned features, faces done), every edit to it, and the plan Toolpath makes from it. Logic only; views belong in @toolpath/ui",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toolpath/ui-packages.git",
    "directory": "packages/plan"
  },
  "homepage": "https://developers.toolpath.com",
  "bugs": {
    "url": "https://github.com/toolpath/ui-packages/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./parts": {
      "types": "./dist/parts/index.d.ts",
      "import": "./dist/parts/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown src/index.ts src/parts/index.ts --format esm --dts --clean --platform neutral",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "test:ci": "pnpm run test"
  },
  "devDependencies": {
    "@toolpath/api": "workspace:^",
    "@toolpath/dev-config": "workspace:^",
    "@types/node": "24.10.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "tsdown": "0.23.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  }
}
