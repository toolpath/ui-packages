import { useState } from 'react'

export interface CounterProps {
  label: string
}

/** A button that counts its own presses. */
export const Counter = ({ label }: CounterProps) => {
  const [count, setCount] = useState(0)
  return (
    <button
      type="button"
      onClick={() => {
        setCount((value) => value + 1)
      }}
    >
      {label}: {count}
    </button>
  )
}
