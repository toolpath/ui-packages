{
  "name": "@toolpath/dev-config",
  "version": "0.3.0",
  "description": "Shared oxlint, TypeScript and React Compiler configuration for Toolpath repositories, with the ESLint and Prettier configs that remain",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toolpath/ui-packages.git",
    "directory": "packages/dev-config"
  },
  "homepage": "https://developers.toolpath.com",
  "bugs": {
    "url": "https://github.com/toolpath/ui-packages/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "exports": {
    "./oxlint": {
      "types": "./dist/oxlint.d.ts",
      "default": "./dist/oxlint.js"
    },
    "./eslint-package": {
      "types": "./dist/eslint-package.d.ts",
      "default": "./dist/eslint-package.js"
    },
    "./prettier": {
      "types": "./dist/prettier.d.ts",
      "default": "./dist/prettier.js"
    },
    "./react-compiler": {
      "types": "./dist/react-compiler.d.ts",
      "default": "./dist/react-compiler.js"
    },
    "./tsconfig/*.json": "./tsconfig/*.json",
    "./tsconfig/*": "./tsconfig/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tsconfig",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "test:ci": "pnpm run test"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "5.18.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-unicorn": "79.0.0",
    "typescript-eslint": "8.72.0"
  },
  "peerDependencies": {
    "@babel/core": "^7.24.0 || ^8.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.0 || ^10.4.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.0.0",
    "typescript": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "babel-plugin-react-compiler": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.10.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.27.7",
    "eslint": "10.9.1",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  }
}
