{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["uv", "uvx"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "packages/app-support": {
      "entry": ["src/index.ts", "src/react/index.ts", "tests/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "packages/dfm": {
      "entry": ["src/index.ts", "src/model/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/plan": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/quoting": {
      "entry": [
        "src/index.ts",
        "src/model/index.ts",
        "src/pipeline/index.ts",
        "src/plan/index.ts",
        "tests/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/sdk-typescript": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignore": ["src/generated/**"]
    },
    "packages/tool-scraper": {
      "entry": [
        "src/index.ts",
        "src/node/index.ts",
        "src/node/main.ts",
        "src/registry.ts",
        "src/families/index.ts",
        "src/vendors/*/index.ts",
        "tests/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/tool-drawing": {
      "entry": [
        "src/index.ts",
        "src/geometry/index.ts",
        "src/clearance/index.ts",
        "tests/**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "packages/tool-support": {
      "entry": [
        "src/index.ts",
        "src/export/index.ts",
        "src/export/fusion/index.ts",
        "src/export/mastercam/index.ts",
        "tests/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/index.ts", "tests/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "packages/viewer": {
      "entry": [
        "src/index.ts",
        "src/engine/index.ts",
        "src/**/*.native.{ts,tsx}",
        "scripts/subset-view-cube-font.mjs",
        "tests/**/*.test.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts"]
    },
    "examples/typescript": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "examples/react-viewer": {
      "entry": [
        "tests/fixtures/explode-policy.ts",
        "tests/fixtures/explode-primitives.tsx",
        "tests/**/*.spec.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts"]
    }
  }
}
