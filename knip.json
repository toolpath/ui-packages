{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["uv", "uvx"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "packages/app-support": {
      "entry": ["src/index.ts", "src/react/index.ts", "tests/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "packages/dev-config": {
      "entry": [
        "src/index.ts",
        "src/eslint/index.ts",
        "src/eslint/plugin/index.ts",
        "src/prettier/index.ts",
        "src/hooks/index.ts",
        "src/testing/vitest.ts",
        "src/testing/playwright.ts",
        "src/testing/jest-expo.ts",
        "src/testing/setup/*.ts",
        "src/react/vite.ts",
        "src/react/babel.ts",
        "src/react/expo.ts",
        "src/react/library.ts",
        "src/engine/testing/index.ts",
        "src/engine/testing/node.ts",
        "src/engine/testing/msw.ts",
        "src/engine/eslint/index.ts",
        "src/cli/main.ts",
        "src/ci/result-policy.mjs",
        "scripts/*.mjs",
        "scripts/compatibility/*.mjs",
        "tests/**/*.test.{ts,tsx}",
        "dev.config.mjs",
        "eslint.config.mjs",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.{ts,mjs}", "scripts/**/*.mjs", "tests/**/*.{ts,tsx}"]
    },
    "packages/dfm": {
      "entry": ["src/index.ts", "src/model/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/plan": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/quoting": {
      "entry": [
        "src/index.ts",
        "src/model/index.ts",
        "src/pipeline/index.ts",
        "src/plan/index.ts",
        "tests/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/sdk-typescript": {
      "project": ["src/**/*.ts"],
      "ignore": ["src/generated/**"]
    },
    "packages/tool-scraper": {
      "entry": [
        "src/index.ts",
        "src/node/index.ts",
        "src/node/main.ts",
        "src/registry.ts",
        "src/families/index.ts",
        "src/vendors/*/index.ts",
        "tests/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/tool-drawing": {
      "entry": [
        "src/index.ts",
        "src/geometry/index.ts",
        "src/clearance/index.ts",
        "tests/**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "packages/tool-support": {
      "entry": [
        "src/index.ts",
        "src/export/index.ts",
        "src/export/fusion/index.ts",
        "src/export/mastercam/index.ts",
        "tests/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/index.ts", "tests/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "packages/viewer": {
      "entry": ["src/index.ts", "src/engine/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts"]
    },
    "examples/typescript": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "examples/react-viewer": {
      "entry": ["tests/**/*.spec.ts"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts"]
    }
  }
}
